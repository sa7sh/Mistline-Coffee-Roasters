PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mistline?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=

JWT_SECRET=your-long-random-secret
ADMIN_EMAIL=admin@mistline.coffee
# ADMIN_PASSWORD must be a bcrypt hash, not the plain password.
# From the server folder, after npm install:
#   node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
# Paste the printed hash here. Type the plain password only on the login page.
ADMIN_PASSWORD=$2b$10$replace-this-with-your-own-bcrypt-hash